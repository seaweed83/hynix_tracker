.page{padding:0 0 20px}
.section{margin:8px 12px;background:#1e293b;border-radius:10px;padding:14px;border:1px solid #334155}
.sec-title{font-size:12px;color:#94a3b8;font-weight:600;margin-bottom:10px}
.form-item{margin-bottom:10px}
.form-l{display:block;font-size:11px;color:#64748b;margin-bottom:4px}
.form-input{width:100%;background:#0b1120;border:1px solid #334155;border-radius:6px;padding:10px;color:#e2e8f0;font-size:14px}
.btn-primary{width:100%;background:#3b82f6;color:#fff;border:none;border-radius:8px;padding:12px;font-size:14px;font-weight:600;text-align:center;margin-bottom:8px}
.btn-secondary{width:100%;background:#1e293b;border:1px solid #334155;color:#94a3b8;border-radius:8px;padding:12px;font-size:14px;text-align:center}
.insight{background:#0b1120;border-radius:6px;padding:10px;margin-bottom:6px;border-left:3px solid #f59e0b}
.insight-title{display:block;font-size:12px;font-weight:600;color:#e2e8f0;margin-bottom:4px}
.insight-body{display:block;font-size:11px;color:#94a3b8;line-height:1.6}
.update-time{text-align:center;font-size:10px;color:#475569;padding:12px}
