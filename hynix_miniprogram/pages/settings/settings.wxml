<view class="page">
  <view class="section">
    <view class="sec-title">⚙️ 服务器配置</view>
    <view class="form-item">
      <text class="form-l">服务器地址</text>
      <input class="form-input" value="{{serverUrl}}" bindinput="onUrlInput" placeholder="http://ip:5800" />
    </view>
    <button class="btn-primary" bindtap="onSave">保存并连接</button>
    <button class="btn-secondary" bindtap="onTest">测试连接</button>
  </view>

  <view class="section">
    <view class="sec-title">📖 使用说明</view>
    <view class="insight neutral">
      <text class="insight-title">第一步：启动后端</text>
      <text class="insight-body">在电脑终端运行: python3 app.py</text>
    </view>
    <view class="insight neutral">
      <text class="insight-title">第二步：填写地址</text>
      <text class="insight-body">填电脑局域网IP:5000 (如 192.168.1.100:5000)</text>
    </view>
    <view class="insight neutral">
      <text class="insight-title">第三步：小程序开发</text>
      <text class="insight-body">在微信开发者工具中预览，真机调试需关闭「校验合法域名」</text>
    </view>
  </view>

  <view class="update-time">{{status}}</view>
</view>
