.page{padding:0 0 20px}
.section{margin:8px 12px;background:#1e293b;border-radius:10px;padding:12px;border:1px solid #334155}
.sec-title{font-size:12px;color:#94a3b8;font-weight:600;margin-bottom:8px}

.bt-table{width:100%;font-size:11px}
.bt-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr 1fr;padding:6px 0;border-bottom:1px solid #1e293b}
.bt-header{color:#64748b;font-weight:500;font-size:10px}
.bt-cell{text-align:center}

.bt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.bt-item{text-align:center;background:#0b1120;border-radius:6px;padding:8px}
.bt-l{display:block;font-size:8px;color:#64748b}
.bt-v{display:block;font-size:14px;font-weight:700;margin-top:2px}
.bt-note{font-size:10px;color:#475569;text-align:center;margin-top:8px}

.corr-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.corr-item{background:#0b1120;border-radius:6px;padding:10px;text-align:center}
.corr-l{display:block;font-size:10px;color:#64748b}
.corr-v{display:block;font-size:20px;font-weight:800}
.corr-p{display:block;font-size:10px;color:#475569}

.update-time{text-align:center;font-size:10px;color:#475569;padding:12px}
.green{color:#22c55e}.red{color:#ef4444}.orange{color:#f59e0b}.blue{color:#3b82f6}
